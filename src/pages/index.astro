---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import '../styles/global.css';

const reader = createReader(process.cwd(), keystaticConfig);
const perfil = await reader.singletons.perfil.read();
const contacto = await reader.singletons.contacto.read();

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site).href;
const title = 'Tomás Banchio — Desarrollador Full Stack';
const description =
  'Desarrollador full stack en Esperanza, Santa Fe. Tres años construyendo producto de punta a punta: React y Next.js, NestJS y ASP.NET Core, SQL, Docker, pagos e identidad.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${canonical.href}#person`,
  name: perfil?.nombre,
  jobTitle: perfil?.rol,
  url: canonical.href,
  email: contacto?.email ? `mailto:${contacto.email}` : undefined,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Esperanza',
    addressRegion: 'Santa Fe',
    addressCountry: 'AR',
  },
  knowsAbout: ['React', 'Next.js', 'NestJS', 'ASP.NET Core', 'TypeScript', 'PostgreSQL', 'Docker'],
  sameAs: [contacto?.githubUrl, contacto?.linkedinUrl].filter(Boolean),
};

const byOrden = (a: { entry: { orden?: number | null } }, b: { entry: { orden?: number | null } }) =>
  (a.entry.orden ?? 0) - (b.entry.orden ?? 0);

const experiencia = (await reader.collections.experiencia.all()).sort(byOrden);
// el periodo se toma de experiencia: una sola fuente de verdad para las fechas
const periodoDe = (empleador: string) => {
  const exp = experiencia.find(({ entry }) => entry.empresa.startsWith(empleador));
  return exp ? `${exp.entry.desde} → ${exp.entry.hasta}` : '';
};
const trabajos = (await reader.collections.proyectosTrabajo.all()).sort(byOrden);
const estudios = (await reader.collections.estudios.all()).sort(byOrden);
const certificados = (await reader.collections.certificados.all()).sort((a, b) => {
  const year = Number(b.entry.anio || 0) - Number(a.entry.anio || 0);
  return year !== 0 ? year : (a.entry.orden ?? 0) - (b.entry.orden ?? 0);
});
const repos = (await reader.collections.repos.all()).sort(byOrden);
const publicados = repos.filter(({ entry }) => Boolean(entry.demo || entry.web));


// --- Monitor CRT en ASCII con una partida de snake (cuadros en build time) ---
const TW = 28;
const TH = 8;
const PAD = "        ";
const INNER = TW + 4;
const loop: Array<[number, number]> = [];
for (let x = 2; x <= 25; x++) loop.push([x, 2]);
for (let y = 3; y <= 7; y++) loop.push([25, y]);
for (let x = 24; x >= 2; x--) loop.push([x, 7]);
for (let y = 6; y >= 3; y--) loop.push([2, y]);

const hud = (frame: number) =>
  ` PUNTOS ${String(4 + frame).padStart(4, "0")}      HI 0031`.padEnd(TW).slice(0, TW);

const playfield = (frames: number) => {
  const cells = new Map<string, string>();
  const head = frames * 4;
  for (let b = 0; b < 6; b++) {
    const [x, y] = loop[(head - b + loop.length * 3) % loop.length];
    cells.set(`${x},${y}`, b === 0 ? "@" : "o");
  }
  const food = [
    [8, 7],
    [21, 2],
    [14, 7],
  ][frames % 3];
  const key = `${food[0]},${food[1]}`;
  if (!cells.has(key)) cells.set(key, "*");
  return Array.from({ length: TH }, (_, y) => {
    if (y === 0) return hud(frames);
    let row = "";
    for (let x = 0; x < TW; x++) row += cells.get(`${x},${y}`) ?? " ";
    return row;
  });
};

const monitor = (frame: number) => [
  PAD + "." + "=".repeat(INNER) + ".",
  PAD + "|" + " ".repeat(INNER) + "|",
  PAD + "| " + "." + "-".repeat(TW) + ". |",
  ...playfield(frame).map((row) => PAD + "| |" + row + "| |"),
  PAD + "| '" + "-".repeat(TW) + "' |",
  PAD + "|" + " ".repeat(INNER) + "|",
  PAD + "|  (o)  TB-2026" + " ".repeat(INNER - 14) + "|",
  PAD + "'" + "=".repeat(INNER) + "'",
  PAD + "     [==================]",
  PAD + "      '----------------'",
  PAD + "       |              |",
  PAD + "  _____|______________|_____",
];

const snake = Array.from({ length: 11 }, (_, f) => monitor(f));

const secciones = [
  { id: 'p1', n: '1', label: 'Perfil' },
  { id: 'p2', n: '2', label: 'Experiencia' },
  { id: 'p3', n: '3', label: 'Stack' },
  { id: 'p4', n: '4', label: 'Proyectos' },
  { id: 'p5', n: '5', label: 'Estudios' },
  { id: 'p6', n: '6', label: 'Contacto' },
];

const stack = [
  {
    titulo: 'Arquitectura frontend',
    descripcion:
      'Interfaces y aplicaciones con React y Next.js: flujos de producto, formularios y consumo de APIs; web con Astro y mobile con React Native.',
    tags: ['React', 'Next.js', 'TypeScript', 'Astro', 'React Native'],
  },
  {
    titulo: 'Arquitectura backend',
    descripcion:
      'APIs y servicios con NestJS y ASP.NET Core: integraciones, autenticación, permisos y contratos compartidos con el frontend.',
    tags: ['NestJS', 'Node.js', 'ASP.NET Core', 'C#'],
  },
  {
    titulo: 'Datos e infraestructura',
    descripcion: 'Modelado, despliegue y operación en producción, on-premise y cloud.',
    tags: ['PostgreSQL', 'SQL Server', 'AWS', 'Azure', 'Terraform'],
  },
  {
    titulo: 'Sistemas y redes',
    descripcion: 'Administración Linux, contenedores y troubleshooting de red.',
    tags: ['Linux', 'Docker', 'TCP/IP', 'DNS', 'SSH', 'Bash'],
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={perfil?.nombre} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0b0a08" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#p1">Saltar a la ficha</a>

    <nav class="menu" aria-label="Secciones">
      {
        secciones.map((s) => (
          <a href={`#${s.id}`} data-nav={s.id}>
            <b>{s.n}</b>
            {s.label}
          </a>
        ))
      }
    </nav>

    <main>
      <section class="win win--id" id="p1" data-page="1" aria-labelledby="t1">
        <h2 class="win__t" id="t1">Identificación</h2>

        <div class="ident">
          <div class="crt" aria-hidden="true">
            {
              snake.map((frame, f) => (
                <pre class="crt__f" style={`--f:${f}`}>{frame.join("\n")}</pre>
              ))
            }
          </div>
          <div class="ident__main">
            <p class="ident__spec">{perfil?.especialidad}</p>
            <h1>{perfil?.nombre}</h1>
            <p class="ident__meta">
              <span>{perfil?.ubicacion}</span>
            </p>

            <dl class="rows">
              {
                perfil?.ficha.map((fila) => (
                  <div class="row">
                    <dt>{fila.etiqueta}</dt>
                    <dd>{fila.valor}</dd>
                  </div>
                ))
              }
            </dl>

            <p class="card-go">
              <a class="btn" href={contacto?.githubUrl} rel="noopener">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                  ></path>
                </svg>
                GitHub
              </a>
              <a class="btn btn--on" href={`mailto:${contacto?.email}`}>
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 2v.01L12 13 4 6.01V6h16zM4 18V8l8 7 8-7v10H4z"
                  ></path>
                </svg>
                Contactar
              </a>
            </p>
          </div>
        </div>

      </section>

      <section class="win" id="p2" data-page="2" aria-labelledby="t2">
        <h2 class="win__t" id="t2">[2] Experiencia</h2>
        {
          experiencia.map(({ entry }) => (
            <article class="entry">
              <div class="entry__head">
                <h3>{entry.empresa}</h3>
                <p class="entry__role">{entry.puesto}</p>
                <p class="entry__when">
                  {`${entry.desde} → ${entry.hasta}`}
                </p>
              </div>
              <ul class="bullets">
                {entry.vinetas.map((vineta) => (
                  <li>
                    <span>{vineta}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section class="win" id="p3" data-page="3" aria-labelledby="t3">
        <h2 class="win__t" id="t3">[3] Stack</h2>
        <div class="stack">
          {
            stack.map((grupo) => (
              <article class="stack__group">
                <h3>{grupo.titulo}</h3>
                <p>{grupo.descripcion}</p>
                <p class="stack__tags">{grupo.tags.join(' · ')}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="win" id="p4" data-page="4" aria-labelledby="t4">
        <h2 class="win__t" id="t4">[4] Proyectos</h2>

        <h3 class="subhead">Profesionales</h3>
        {
          trabajos.map(({ entry }) => {
            const periodo = periodoDe(entry.empleador);
            return (
              <article class="entry">
                <div class="entry__head">
                  <h3>
                    <a href={entry.web} rel="noopener" aria-label={`${entry.nombre} — ver producto`}>
                      {entry.nombre}
                    </a>
                  </h3>
                  <p class="entry__when">{entry.empleador}{periodo && ` · ${periodo}`}</p>
                </div>
                <p>{entry.descripcion}</p>
              </article>
            );
          })
        }

        <h3 class="subhead">Personales</h3>
        <ul class="plain">
        {
          publicados.map(({ entry }) => (
            <li>
              <span>
                {entry.web ? (
                  <a
                    href={entry.web}
                    rel="noopener"
                    aria-label={`${entry.nombre} — ver repositorio`}
                  >
                    {entry.nombre}
                  </a>
                ) : (
                  entry.nombre
                )}
                {' · '}{entry.lenguaje}
                <span class="plain__desc">{entry.descripcion}</span>
              </span>
              <span class="list__end">
                <span>{entry.anio}</span>
                {entry.demo && (
                  <a class="btn btn--sm" href={entry.demo}>
                    ver demo
                  </a>
                )}
              </span>
            </li>
          ))
        }
        </ul>
      </section>

      <section class="win" id="p5" data-page="5" aria-labelledby="t5">
        <h2 class="win__t" id="t5">[5] Estudios y certificados</h2>
        <ul class="plain">
          {
            estudios.map(({ entry }) => (
              <li>
                <span>
                  {entry.etiqueta}: {entry.titulo} · {entry.institucion}
                </span>
                <span>{entry.periodo}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="subhead">Certificaciones</h3>
        <ul class="plain">
          {
            certificados.map(({ entry }) => (
              <li>
                <span>
                  {entry.titulo} · {entry.emisor}
                  {entry.detalle ? ` · ${entry.detalle}` : ''}
                </span>
                <span class="list__end">
                  {entry.anio && <span>{entry.anio}</span>}
                  {entry.url && (
                    <a
                      class="btn btn--sm"
                      href={entry.url}
                      rel="noopener"
                      target="_blank"
                      aria-label={`Ver certificado: ${entry.titulo}`}
                    >
                      ver certificado
                    </a>
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="win" id="p6" data-page="6" aria-labelledby="t6">
        <h2 class="win__t" id="t6">[6] Contacto</h2>
        <div class="rows">
          <a class="row" href={`mailto:${contacto?.email}`}>
            <span class="row__k">Mail</span>
            <span class="row__v">{contacto?.email}</span>
          </a>
          <a class="row" href={contacto?.githubUrl} rel="noopener">
            <span class="row__k">GitHub</span>
            <span class="row__v">{contacto?.github}</span>
          </a>
          <a class="row" href={contacto?.linkedinUrl} rel="noopener">
            <span class="row__k">LinkedIn</span>
            <span class="row__v">{contacto?.linkedin}</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="status">
      <span><em>[1..6]</em> secciones</span>
      <span><em>[c]</em> fósforo</span>
      <span><em>[↑↓]</em> desplazar</span>
      <span class="status__end">{contacto?.email} · Low Tek, High Life.</span>
    </footer>

    <script src="/app.js" defer></script>
  </body>
</html>
