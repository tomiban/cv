---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import '../styles/global.css';

const reader = createReader(process.cwd(), keystaticConfig);
const perfil = await reader.singletons.perfil.read();
const stack = await reader.singletons.stack.read();
const contacto = await reader.singletons.contacto.read();

const byOrden = (a: { entry: { orden?: number | null } }, b: { entry: { orden?: number | null } }) =>
  (a.entry.orden ?? 0) - (b.entry.orden ?? 0);

const experiencia = (await reader.collections.experiencia.all()).sort(byOrden);
const trabajos = (await reader.collections.proyectosTrabajo.all()).sort(byOrden);
const estudios = (await reader.collections.estudios.all()).sort(byOrden);
const certificados = (await reader.collections.certificados.all()).sort(byOrden);
const repos = (await reader.collections.repos.all()).sort(byOrden);

const subpaginas = [1, 2].map((n) => repos.filter(({ entry }) => entry.subpagina === n));
const indexRows = [
  { page: '200', label: 'Perfil', value: perfil?.kicker ?? '' },
  {
    page: '300',
    label: 'Experiencia',
    value: experiencia.map(({ entry }) => entry.empresa.split(',')[0]).join(' · '),
  },
  { page: '400', label: 'Stack', value: 'C# · TS · SQL · Docker' },
  {
    page: '500',
    label: 'Proyectos',
    value: trabajos.map(({ entry }) => entry.nombre).join(' · '),
  },
  { page: '600', label: 'Repos', value: 'Nueve públicos' },
  { page: '700', label: 'Estudios', value: 'ITEC · Crombie Academy' },
  { page: '800', label: 'Contacto', value: 'Escribime' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tomás Banchio — Desarrollador Full Stack</title>
    <meta
      name="description"
      content="Desarrollador full stack en Esperanza, Santa Fe. Tres años construyendo producto de punta a punta: React y Next.js, NestJS y ASP.NET Core, SQL, Docker, pagos e identidad."
    />
    <meta name="theme-color" content="#06070a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/jersey-15.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content="Tomás Banchio — Desarrollador Full Stack" />
    <meta
      property="og:description"
      content="Tres años construyendo producto de punta a punta: trámites municipales, pagos e identidad. Una página, ocho páginas de teletexto."
    />
    <meta property="og:url" content="https://tomiban.github.io/" />
  </head>
  <body>
    <a class="skip" href="#p100">Saltar al índice</a>

    <header class="top">
      <p class="top__id">
        <a href="#p100"
          >Tomás Banchio<span class="cell" aria-hidden="true"></span
          ><span class="top__role">Desarrollador Full Stack</span></a
        >
      </p>
      <form class="top__go" id="ir" hidden>
        <label for="pagina">Página</label>
        <input
          id="pagina"
          name="pagina"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          maxlength="3"
          size="3"
          placeholder="300"
          aria-describedby="aviso"
        />
        <button type="submit">Ir</button>
      </form>
      <p class="top__stamp">
        <b id="pagina-actual">P100</b>/<i id="subpagina-actual">1</i>
        <time id="reloj">--:--</time>
      </p>
      <p class="top__msg" id="aviso" role="status" aria-live="polite"></p>
    </header>

    <main>
      <section class="page page--index" id="p100" data-page="100" aria-labelledby="t100">
        <h1 id="t100"><span>Tomás</span> <span>Banchio</span></h1>
        <p class="where">
          {perfil?.ubicacion}<span class="cell" aria-hidden="true"></span>{perfil?.kicker}
        </p>

        <p class="lead">{perfil?.lead}</p>

        <div class="index-grid">
          <nav aria-label="Índice de páginas">
            <ol class="index">
              {
                indexRows.map((row) => (
                  <li>
                    <a href={`#p${row.page}`}>
                      <b>{row.page}</b>
                      <span>{row.label}</span>
                      <i></i>
                      <em>{row.value}</em>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>

          <div class="card-test" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span
            ><span></span><span></span><span></span>
            <p>Un sol de celdas</p>
          </div>
        </div>

        <p class="status">
          8 páginas<span class="cell" aria-hidden="true"></span>Actualizado {
            contacto?.actualizado
          }<span class="cell" aria-hidden="true"></span>Esperanza, Santa Fe
        </p>
      </section>

      <section class="page" id="p200" data-page="200" aria-labelledby="t200">
        <div class="bar">
          <h2 id="t200"><b>200</b> Perfil</h2>
          <span class="bar__stamp">P200/1</span>
        </div>
        <div class="prose">
          {perfil?.parrafos.map((parrafo) => <p>{parrafo}</p>)}
        </div>
        <dl class="record">
          {
            perfil?.ficha.map((fila) => (
              <div>
                <dt>{fila.etiqueta}</dt>
                <dd>{fila.valor}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="page" id="p300" data-page="300" aria-labelledby="t300">
        <div class="bar">
          <h2 id="t300"><b>300</b> Experiencia</h2>
          <span class="bar__stamp">P300/1</span>
        </div>

        {
          experiencia.map(({ entry }) => (
            <article class="job">
              <div class="job__head">
                <h3>{entry.empresa}</h3>
                <p class="job__role">{entry.puesto}</p>
                <p class="job__when">
                  {entry.enCurso && <span class="flag">Hoy</span>}
                  {` ${entry.desde} — ${entry.hasta}`}
                </p>
              </div>
              <ul class="bullets">
                {entry.vinetas.map((vineta) => (
                  <li>{vineta}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section class="page" id="p400" data-page="400" aria-labelledby="t400">
        <div class="bar">
          <h2 id="t400"><b>400</b> Stack</h2>
          <span class="bar__stamp">P400/1</span>
        </div>
        <dl class="record record--wide">
          {
            stack?.grupos.map((grupo) => (
              <div>
                <dt>{grupo.titulo}</dt>
                <dd>{grupo.valor}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="page" id="p500" data-page="500" aria-labelledby="t500">
        <div class="bar">
          <h2 id="t500"><b>500</b> Proyectos de trabajo</h2>
          <span class="bar__stamp">P500/1</span>
        </div>
        <p class="note">
          Productos de mis empleadores. Sin código público, sin capturas: acá está lo que construí y
          con qué.
        </p>

        {
          trabajos.map(({ entry }) => (
            <article class="work">
              <div class="work__head">
                <h3>{entry.nombre}</h3>
                <p class="work__when">{entry.empleador}</p>
              </div>
              <p>{entry.descripcion}</p>
              <p class="flag flag--row">{entry.privacidad}</p>
            </article>
          ))
        }
      </section>

      <section class="page" id="p600" data-page="600" aria-labelledby="t600">
        <div class="bar">
          <h2 id="t600"><b>600</b> Repos</h2>
          <span class="bar__stamp" id="stamp600">P600/1</span>
        </div>

        <div class="subs" id="subs600">
          {
            subpaginas.map((pagina, i) => (
              <div class="sub" data-sub={String(i + 1)} hidden={i !== 0}>
                <ul class="repos">
                  {pagina.map(({ entry }) => (
                    <li>
                      <a href={entry.url} rel="noopener">
                        <span class="repo__name">{entry.nombre}</span>
                        <span class="repo__meta">
                          {entry.lenguaje}
                          <span class="cell" aria-hidden="true" />
                          {entry.anio}
                        </span>
                        <span class="repo__desc">{entry.descripcion}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="subs__ctrl">
          <button type="button" class="key" data-sub-step="-1">Anterior</button>
          <button type="button" class="key" data-sub-step="1">Siguiente</button>
          <button type="button" class="key key--hold" id="hold600">Pausa</button>
          <p class="subs__count" id="count600">Subpágina 1/2</p>
        </div>
        <p class="note">
          Nueve repositorios públicos en <a href="https://github.com/tomiban" rel="noopener"
            >github.com/tomiban</a
          >. La demo viva de la tienda está en <a
            href="https://tomiban.github.io/mi-tienda-react/"
            rel="noopener">tomiban.github.io/mi-tienda-react</a
          >.
        </p>
      </section>

      <section class="page" id="p700" data-page="700" aria-labelledby="t700">
        <div class="bar">
          <h2 id="t700"><b>700</b> Estudios</h2>
          <span class="bar__stamp">P700/1</span>
        </div>
        <dl class="record record--wide">
          {
            estudios.map(({ entry }) => (
              <div>
                <dt>{entry.etiqueta}</dt>
                <dd>
                  {entry.titulo} · {entry.institucion}
                  <span class="when">{entry.periodo}</span>
                </dd>
              </div>
            ))
          }
        </dl>

        <h3 class="minor">Certificaciones</h3>
        <ul class="certs">
          {
            certificados.map(({ entry }) => (
              <li>
                {entry.titulo}
                {entry.emisor ? ` · ${entry.emisor}` : ''}
                <span class="when">{entry.anio}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="page" id="p800" data-page="800" aria-labelledby="t800">
        <div class="bar">
          <h2 id="t800"><b>800</b> Contacto</h2>
          <span class="bar__stamp">P800/1</span>
        </div>
        <ol class="index index--contact">
          <li>
            <a href={`mailto:${contacto?.email}`}>
              <b>Mail</b><span>{contacto?.email}</span><i></i><em>Abrir</em>
            </a>
          </li>
          <li>
            <a href={contacto?.githubUrl} rel="noopener">
              <b>GitHub</b><span>{contacto?.github}</span><i></i><em>Abrir</em>
            </a>
          </li>
          <li>
            <a href={contacto?.linkedinUrl} rel="noopener">
              <b>LinkedIn</b><span>{contacto?.linkedin}</span><i></i><em>Abrir</em>
            </a>
          </li>
        </ol>
        <p class="note">{contacto?.nota}</p>
        <dl class="record record--visits">
          <div>
            <dt>Visitas</dt>
            <dd><span id="visitas">—</span> en este navegador</dd>
          </div>
          <div>
            <dt>Actualizado</dt>
            <dd>{contacto?.actualizado}</dd>
          </div>
        </dl>
      </section>
    </main>

    <footer class="end">
      <p class="end__line">
        Fin de la transmisión<span class="cell" aria-hidden="true"></span><span
          >Low Tek, High Life.</span
        >
      </p>
      <nav class="fast" aria-label="Accesos rápidos">
        <a href="#p600" data-key="red"><s aria-hidden="true"></s>600 Repos</a>
        <a href="#p300" data-key="green"><s aria-hidden="true"></s>300 Exp.</a>
        <a href="#p500" data-key="yellow"><s aria-hidden="true"></s>500 Proyectos</a>
        <a href="#p800" data-key="cyan"><s aria-hidden="true"></s>800 Contacto</a>
      </nav>
    </footer>

    <script src="/app.js" defer></script>
  </body>
</html>
