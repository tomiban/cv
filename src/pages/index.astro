---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Base from '../layouts/Base.astro';
import Escribime from '../components/Escribime.astro';

const reader = createReader(process.cwd(), keystaticConfig);
const oferta = await reader.singletons.oferta.read();
const perfil = await reader.singletons.perfil.read();
const contacto = await reader.singletons.contacto.read();

// retrato ASCII generado con scripts/ascii.py; si no existe, el hero va a una columna
const retratos = import.meta.glob<string>('../assets/retrato*.txt', { query: '?raw', import: 'default', eager: true });
const retrato = retratos['../assets/retrato.txt'];
const retratoOscuro = retratos['../assets/retrato-oscuro.txt'] ?? retrato;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site).href;
const title = 'Tomás Banchio — Software a medida y automatizaciones en Santa Fe';
const description =
  'Desarrollador de software en Esperanza, Santa Fe. Sistemas a medida, automatizaciones con IA, integraciones con Mercado Pago y login, webs y apps para pymes, organismos y equipos. Escribime por WhatsApp.';
// misma localidad que el Perfil de Empresa de Google: nombre, zona y web tienen que coincidir
const address = {
  '@type': 'PostalAddress',
  addressLocality: 'Esperanza',
  addressRegion: 'Santa Fe',
  addressCountry: 'AR',
};
const sameAs = [contacto?.githubUrl, contacto?.linkedinUrl].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${canonical.href}#person`,
      name: perfil?.nombre,
      jobTitle: perfil?.rol,
      url: canonical.href,
      email: contacto?.email ? `mailto:${contacto.email}` : undefined,
      address,
      knowsAbout: ['React', 'Next.js', 'NestJS', 'ASP.NET Core', 'TypeScript', 'PostgreSQL', 'Docker', 'Mercado Pago', 'Keycloak', 'Automatización de procesos', 'Inteligencia artificial'],
      sameAs,
    },
    {
      // negocio de área de servicio: sin local abierto al público, por eso no lleva calle ni horarios
      '@type': 'ProfessionalService',
      '@id': `${canonical.href}#negocio`,
      name: perfil?.nombre,
      description,
      url: canonical.href,
      image: ogImage,
      email: contacto?.email ? `mailto:${contacto.email}` : undefined,
      founder: { '@id': `${canonical.href}#person` },
      address,
      areaServed: [
        { '@type': 'City', name: 'Esperanza' },
        { '@type': 'City', name: 'Santa Fe' },
        { '@type': 'City', name: 'Santo Tomé' },
        { '@type': 'City', name: 'Rafaela' },
        { '@type': 'City', name: 'Paraná' },
        { '@type': 'AdministrativeArea', name: 'Provincia de Santa Fe' },
        { '@type': 'Country', name: 'Argentina' },
      ],
      makesOffer: oferta?.servicios.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.titulo, description: s.descripcion },
      })),
      sameAs,
    },
  ],
};

const byOrden = (a: { entry: { orden?: number | null } }, b: { entry: { orden?: number | null } }) =>
  (a.entry.orden ?? 0) - (b.entry.orden ?? 0);

const experiencia = (await reader.collections.experiencia.all()).sort(byOrden);
// el periodo se toma de experiencia: una sola fuente de verdad para las fechas
const periodoDe = (empleador: string) => {
  const exp = experiencia.find(({ entry }) => entry.empresa.startsWith(empleador));
  return exp ? `${exp.entry.desde} – ${exp.entry.hasta}` : '';
};
const casos = (await reader.collections.proyectosTrabajo.all()).sort(byOrden);
const estudios = (await reader.collections.estudios.all()).sort(byOrden);
const certificados = (await reader.collections.certificados.all()).sort((a, b) => {
  const year = Number(b.entry.anio || 0) - Number(a.entry.anio || 0);
  return year !== 0 ? year : (a.entry.orden ?? 0) - (b.entry.orden ?? 0);
});
const repos = (await reader.collections.repos.all()).sort(byOrden);
// en el perfil van solo los proyectos marcados como destacados y con algo para abrir
const publicados = repos.filter(({ entry }) => entry.destacado && Boolean(entry.demo || entry.web));

const secciones = [
  { id: 'servicios', label: 'Servicios' },
  { id: 'casos', label: 'Casos' },
  { id: 'proceso', label: 'Cómo trabajo' },
  { id: 'perfil', label: 'Perfil' },
];
const nav = secciones.map((s) => ({ href: `#${s.id}`, label: s.label }));

const stack = [
  { titulo: 'Frontend', tags: ['React', 'Next.js', 'TypeScript', 'Astro', 'React Native'] },
  { titulo: 'Backend', tags: ['NestJS', 'Node.js', 'ASP.NET Core', 'C#'] },
  { titulo: 'Datos y cloud', tags: ['PostgreSQL', 'SQL Server', 'AWS', 'Azure', 'Terraform'] },
  { titulo: 'Sistemas', tags: ['Linux', 'Docker', 'TCP/IP', 'DNS', 'SSH', 'Bash'] },
];

// la cinta repite la lista dos veces para que el desplazamiento no tenga corte
const cinta = [
  'React', 'Next.js', 'React Native', 'TypeScript', 'JavaScript', 'Astro', 'Tailwind',
  'NestJS', 'Node.js', 'ASP.NET Core', 'C#', 'Laravel', 'PHP', 'REST APIs', 'Microservicios',
  'PostgreSQL', 'SQL Server', 'Docker', 'AWS', 'Azure', 'Terraform', 'Linux', 'CI/CD',
  'OIDC', 'OAuth', 'Claude Code',
];

const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<Base title={title} description={description} jsonLd={jsonLd} nav={nav}>
      <section class:list={['hero', { 'hero--retrato': retrato }]} aria-labelledby="hero-t">
        <div class="hero__text">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{oferta?.etiqueta}</p>
        <h1 id="hero-t">{oferta?.titular}</h1>
        <p class="hero__lead">{oferta?.bajada}</p>
        <p class="actions">
          <Escribime class="btn--accent" icono />
          <a class="btn" href="#casos">Ver casos</a>
        </p>
        </div>
        {
          retrato && (
            <figure class="retrato">
              <pre class="retrato__claro" aria-hidden="true">{retrato}</pre>
              <pre class="retrato__oscuro" aria-hidden="true">{retratoOscuro}</pre>
              <figcaption class="mono">
                <span aria-hidden="true">$ cat tomas.txt</span>
                <span class="sr-only">Retrato de Tomás Banchio en ASCII</span>
              </figcaption>
            </figure>
          )
        }
      </section>

      <div class="ticker">
        <ul class="ticker__track" aria-label="Tecnologías con las que trabajo">
          {cinta.map((t) => <li>{t}</li>)}
        </ul>
        <ul class="ticker__track" aria-hidden="true">
          {cinta.map((t) => <li>{t}</li>)}
        </ul>
      </div>

      <section class="block" id="servicios" aria-labelledby="servicios-t">
        <header class="block__head">
          <p class="kicker">Servicios</p>
          <h2 id="servicios-t">Qué puedo hacer por tu proyecto</h2>
        </header>
        <ol class="services">
          {
            oferta?.servicios.map((s, i) => (
              <li class="service reveal">
                <span class="service__n" aria-hidden="true">{pad(i)}</span>
                <h3>{s.pagina ? <a href={`/${s.pagina}`}>{s.titulo}</a> : s.titulo}</h3>
                <p>{s.descripcion}</p>
                <p class="service__for"><span>Ideal para</span> {s.para}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="block" id="casos" aria-labelledby="casos-t">
        <header class="block__head">
          <p class="kicker">Casos</p>
          <h2 id="casos-t">Software que hoy está en producción</h2>
        </header>
        {
          casos.map(({ entry }) => {
            const periodo = periodoDe(entry.empleador);
            return (
              <article class="case reveal">
                <div class="case__meta">
                  <h3>
                    <a href={entry.web} rel="noopener" target="_blank">
                      {entry.nombre}
                      <span class="sr-only"> (abre en otra pestaña)</span>
                    </a>
                  </h3>
                  <p>{entry.cliente}</p>
                  <p class="mono">
                    vía {entry.empleador}
                    {periodo && ` · ${periodo}`}
                  </p>
                  <p class="mono case__stack">{entry.stack}</p>
                </div>
                <dl class="case__body">
                  <div>
                    <dt>El problema</dt>
                    <dd>{entry.desafio}</dd>
                  </div>
                  <div>
                    <dt>Mi rol</dt>
                    <dd>{entry.rol}</dd>
                  </div>
                  <div>
                    <dt>En qué trabajé</dt>
                    <dd>
                      <ul>
                        {entry.solucion.map((punto) => (
                          <li>{punto}</li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                  <div class="case__result">
                    <dt>Resultado</dt>
                    <dd>{entry.resultado}</dd>
                  </div>
                </dl>
              </article>
            );
          })
        }
      </section>

      <section class="block block--band" id="proceso" aria-labelledby="proceso-t">
        <header class="block__head">
          <p class="kicker">Cómo trabajo</p>
          <h2 id="proceso-t">Sin sorpresas, de la charla a la puesta en marcha</h2>
        </header>
        <ol class="steps">
          {
            oferta?.pasos.map((p, i) => (
              <li class="reveal">
                <span class="steps__n" aria-hidden="true">{pad(i)}</span>
                <h3>{p.titulo}</h3>
                <p>{p.descripcion}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="block" id="perfil" aria-labelledby="perfil-t">
        <header class="block__head">
          <p class="kicker">Perfil</p>
          <h2 id="perfil-t">¿Buscás sumar a alguien al equipo?</h2>
          <p class="block__lead">
            También trabajo en relación de dependencia. {perfil?.especialidad}, con experiencia en equipos
            ágiles y producto en producción.
          </p>
        </header>

        <div class="profile">
          <dl class="facts">
            {
              perfil?.ficha.map((fila) => (
                <div>
                  <dt>{fila.etiqueta}</dt>
                  <dd>{fila.valor}</dd>
                </div>
              ))
            }
          </dl>

          <div class="timeline">
            {
              experiencia.map(({ entry }) => (
                <article class="job">
                  <p class="mono job__when">{`${entry.desde} – ${entry.hasta}`}</p>
                  <h3>
                    {entry.puesto} <span>· {entry.empresa}</span>
                  </h3>
                  <ul>
                    {entry.vinetas.map((vineta) => (
                      <li>{vineta}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>

        <div class="stack">
          {
            stack.map((grupo) => (
              <div>
                <h3 class="mono">{grupo.titulo}</h3>
                <ul class="tags">
                  {grupo.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <ul class="studies">
          {
            estudios.map(({ entry }) => (
              <li>
                <span class="mono">{entry.periodo}</span>
                <span>
                  <strong>{entry.titulo}</strong> · {entry.institucion}
                </span>
              </li>
            ))
          }
        </ul>

        <h3 class="subhead">Proyectos propios</h3>
        <ul class="repos">
          {
            publicados.map(({ entry }) => (
              <li>
                <a href={entry.demo || entry.web} rel="noopener" target="_blank">
                  <span class="repos__name">{entry.nombre}</span>
                  <span class="repos__desc">{entry.descripcion}</span>
                  <span class="mono repos__meta">
                    {entry.lenguaje} · {entry.anio}
                    {entry.demo ? ' · demo' : ' · código'}
                  </span>
                  <span class="sr-only"> (abre en otra pestaña)</span>
                </a>
              </li>
            ))
          }
        </ul>

        <details class="certs">
          <summary>Certificaciones ({certificados.length})</summary>
          <ul>
            {
              certificados.map(({ entry }) => (
                <li>
                  <span class="mono">{entry.anio}</span>
                  <span>
                    {entry.url ? (
                      <a href={entry.url} rel="noopener" target="_blank">
                        {entry.titulo}
                        <span class="sr-only"> (ver certificado, abre en otra pestaña)</span>
                      </a>
                    ) : (
                      entry.titulo
                    )}
                    {' · '}
                    {entry.emisor}
                    {entry.detalle ? ` · ${entry.detalle}` : ''}
                  </span>
                </li>
              ))
            }
          </ul>
        </details>

        <p class="actions">
          <a class="btn" href={contacto?.linkedinUrl} rel="noopener">LinkedIn</a>
          <a class="btn" href={contacto?.githubUrl} rel="noopener">GitHub</a>
        </p>
      </section>

      <section class="cta" id="contacto" aria-labelledby="cta-t">
        <h2 id="cta-t">¿Tenés un proceso que se podría resolver con software?</h2>
        <p>Contame en dos líneas qué necesitás y lo vemos juntos.</p>
        <p class="actions">
          <Escribime class="btn--ink" icono />
          <a class="btn btn--line" href={`mailto:${contacto?.email}`}>{contacto?.email}</a>
        </p>
      </section>
</Base>
